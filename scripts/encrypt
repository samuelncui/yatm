#!/usr/bin/env bash
set -ex;

mkdir -p "${TAPE_DIR}"
exec > >(tee -a "${TAPE_DIR}/ltfs.log") 2>&1

mt -f "${DEVICE}" load
sleep 5

for i in {1..60}; do
    # stenc 2.0.0: put TAPE_BARCODE on line 2 of KEY_FILE, then use this command without -kd:
    # stenc -f "${DEVICE}" -e on -k "${KEY_FILE}" -a 1 --ckod
    if stenc -f "${DEVICE}" -e on -k "${KEY_FILE}" -kd "${TAPE_BARCODE}" -a 1 --ckod; then
        sleep 3
        exit 0
    fi
    if (( i == 60 )); then
        exit 1
    fi
    sleep 5
done
