  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "@samuelncui/chonky@0.3.2": "patches/@samuelncui__chonky@0.3.2.patch"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc6 && vite build",
    "typecheck": "tsc6",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview",
    "gen-proto": "protoc --ts_out ./src/entity --proto_path ../entity/ `ls ../entity/*.proto` && ./src/entity/gen_index.sh"
